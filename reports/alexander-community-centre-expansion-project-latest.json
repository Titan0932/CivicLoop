        "id": "fb-d35190e1dd01ed",
        "theme": "Desire for expanded group activity spaces",
        "summary": "Residents want more opportunities for group activities for children and adults.",
        "responseStatus": "no_public_response",
        "response": "No municipal response was found in this source.",
        "feedbackSourceId": "src-community-3e371b0b921d6c",
        "responseSourceId": null,

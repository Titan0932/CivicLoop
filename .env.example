# Preferred hosted provider. When configured, CivicLoop tries Gemini first and
# automatically falls back to the local model if Gemini is unavailable or out of quota.
GEMINI_API_KEY=
CIVICLOOP_GEMINI_MODEL=gemini-3.5-flash

# Optional OpenAI provider for explicit CLI analysis.
OPENAI_API_KEY=
CIVICLOOP_LLM_MODEL=gpt-5-mini

# Local OpenAI-compatible semantic provider defaults.
CIVICLOOP_LOCAL_LLM_URL=http://127.0.0.1:8001/v1
CIVICLOOP_LOCAL_LLM_MODEL=mlx-community/Qwen3.5-9B-4bit

# Optional database override. Defaults to data/civicloop.db.
CIVICLOOP_DB_PATH=

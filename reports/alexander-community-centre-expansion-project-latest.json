        "evidenceExcerpt": "These concepts included adding a full-size gymnasium and creating more increase opportunities for group activities for children and adults."
      },
      {
        "id": "fb-9ca21595172156",
        "theme": "Potential inclusion of a library",
        "summary": "Some residents suggested potentially adding a library to the expansion.",
        "responseStatus": "no_public_response",
        "response": "No municipal response was found in this source.",
        "feedbackSourceId": "src-community-3e371b0b921d6c",
        "responseSourceId": null,
        "verification": "needs_review",
        "evidenceExcerpt": "These concepts included adding a full-size gymnasium and creating more increase opportunities for group activities for children and adults, such as day programs, events, meetings and potentially a library."
      },
      {
        "id": "fb-f538d2ebe0094b",
        "theme": "Kitchen requirements and location",
        "summary": "A bigger kitchen that can accommodate two families cooking at the same time is requested. The kitchen should have access to greenspace or the courtyard.",
        "responseStatus": "no_public_response",
        "response": "No municipal response was found in this source.",
        "feedbackSourceId": "src-community-a5463111dcf9ac",
